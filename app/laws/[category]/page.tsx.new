import Link from "next/link";
import { notFound } from "next/navigation";
import { ArrowRight, BookOpen, FileText } from "lucide-react";
import PageHeader from "@/components/PageHeader";
import StatuteStatusBadge from "@/components/statute/StatuteStatusBadge";
import {
  categories,
  getAllCategorySlugs,
  getCategoryBySlug,
} from "@/lib/categories";
import {
  getStatutesByCategory,
  categoryCoverage,
} from "@/lib/statutes/_registry";

type Props = { params: { category: string } };

export function generateStaticParams() {
  return getAllCategorySlugs().map((slug) => ({ category: slug }));
}

export function generateMetadata({ params }: Props) {
  const cat = getCategoryBySlug(params.category);
  if (!cat) return { title: "Not Found" };
  return { title: cat.title, description: cat.description };
}

export default function CategoryPage({ params }: Props) {
  const cat = getCategoryBySlug(params.category);
  if (!cat) return notFound();

  const Icon = cat.icon;
  const idx = categories.findIndex((c) => c.slug === cat.slug);
  const related = [1, 2, 3].map((d) => categories[(idx + d) % categories.length]);

  const acts = getStatutesByCategory(cat.slug);
  const coverage = categoryCoverage(cat.slug);

  // Group by tier for display
  const byTier = [1, 2, 3, 4].map((tier) => ({
    tier,
    items: acts.filter((a) => a.tier === tier),
  }));

  return (
    <>
      <PageHeader
        eyebrow={`${cat.sanskrit} · ${cat.tagline}`}
        title={cat.title}
        description={cat.description}
        crumbs={[
          { label: "Home", href: "/" },
          { label: "All Laws", href: "/laws" },
          { label: cat.title },
        ]}
      />

      {/* Hero ribbon */}
      <section className="container-page">
        <div className="relative overflow-hidden rounded-3xl border border-saffron-200 bg-gradient-to-br from-paper-100 via-paper-50 to-saffron-50/60 p-8 lg:p-10">
          <div className="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full bg-saffron-300/20 blur-3xl" />
          <div className="relative flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
            <div className="flex items-center gap-5">
              <div className="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-saffron-500 text-white shadow-glow">
                <Icon className="h-6 w-6" />
              </div>
              <div>
                <p className="devanagari text-sm text-ink-500">{cat.sanskrit}</p>
                <p className="mt-1 font-serif text-2xl font-medium text-ink-900">
                  {cat.tagline}
                </p>
              </div>
            </div>
            <div className="flex flex-wrap gap-2">
              <span className="tag-saffron">{coverage.total} Acts</span>
              <span className="tag-india">{coverage.complete} authored</span>
              {coverage.inProgress > 0 && (
                <span className="tag">{coverage.inProgress} in progress</span>
              )}
            </div>
          </div>
        </div>
      </section>

      <section className="container-page mt-16 pb-24">
        <div className="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
          {/* Sticky sidebar */}
          <aside className="lg:col-span-3">
            <div className="lg:sticky lg:top-32">
              <p className="text-[11px] font-semibold uppercase tracking-[0.18em] text-ink-400">
                In this section
              </p>
              <nav className="mt-4 space-y-0.5 border-l border-ink-100 pl-4">
                {[
                  ["Overview", "#overview"],
                  ["Acts in this category", "#acts"],
                  ["Related categories", "#related"],
                ].map(([label, href]) => (
                  <a
                    key={href}
                    href={href}
                    className="block py-1.5 text-sm text-ink-500 transition-colors hover:text-saffron-600"
                  >
                    {label}
                  </a>
                ))}
              </nav>
              <div className="mt-8 rounded-2xl border border-ink-100 bg-paper-50 p-5">
                <p className="eyebrow">How to read</p>
                <p className="mt-3 font-serif text-lg font-medium leading-tight text-ink-900">
                  Each Act, deeply.
                </p>
                <p className="mt-2 text-[13px] leading-relaxed text-ink-500">
                  Open any statute below to see chapter-by-chapter notes, every operative section quoted verbatim, scenarios, FAQs, and a link to the source PDF.
                </p>
              </div>
            </div>
          </aside>

          {/* Main */}
          <div className="lg:col-span-9 space-y-16">
            <section id="overview">
              <p className="eyebrow">Overview</p>
              <h2 className="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-ink-900">
                What this category covers
              </h2>
              <p className="mt-4 max-w-2xl text-pretty text-[16px] leading-relaxed text-ink-500">
                {cat.description}
              </p>
            </section>

            <section id="acts">
              <div className="mb-6 flex items-end justify-between gap-4">
                <div>
                  <p className="eyebrow">Statutes</p>
                  <h2 className="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-ink-900">
                    Acts in this category
                  </h2>
                </div>
                <span className="hidden text-xs uppercase tracking-[0.18em] text-ink-400 tabular sm:inline">
                  {coverage.total} acts · {coverage.complete} live
                </span>
              </div>

              {byTier
                .filter((g) => g.items.length > 0)
                .map((g) => (
                  <div key={g.tier} className="mb-10 last:mb-0">
                    <div className="mb-3 flex items-center gap-3">
                      <span className="text-[11px] font-semibold uppercase tracking-[0.18em] text-saffron-700">
                        Tier {g.tier}
                      </span>
                      <span className="h-px flex-1 bg-ink-100" />
                      <span className="text-[11px] uppercase tracking-wider text-ink-400 tabular">
                        {g.items.length}
                      </span>
                    </div>
                    <ul className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                      {g.items.map((act) => (
                        <li key={act.slug}>
                          <Link
                            href={`/laws/${cat.slug}/${act.slug}`}
                            className="group card-heritage flex h-full items-start gap-4 p-5"
                          >
                            <span className="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-saffron-50 text-saffron-700">
                              <FileText className="h-4 w-4" />
                            </span>
                            <div className="min-w-0 flex-1">
                              <div className="flex flex-wrap items-center gap-2">
                                <span className="font-mono text-[10.5px] font-semibold uppercase tracking-wider text-ink-400 tabular">
                                  {act.year}
                                </span>
                                <StatuteStatusBadge coverage={act.coverage} />
                              </div>
                              <h3 className="mt-1.5 font-serif text-[17px] font-medium leading-snug text-ink-900">
                                {act.shortName}
                              </h3>
                              <p className="mt-1 line-clamp-2 text-[13px] text-ink-500">
                                {act.summary}
                              </p>
                              <p className="mt-3 flex items-center gap-1.5 text-[11px] uppercase tracking-wider text-ink-400 tabular">
                                <BookOpen className="h-3 w-3" />
                                {act.totalSections} sections · {act.totalChapters} chapters
                              </p>
                            </div>
                            <ArrowRight className="h-4 w-4 shrink-0 text-ink-400 transition-all group-hover:translate-x-0.5 group-hover:text-saffron-600" />
                          </Link>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
            </section>

            <section id="related">
              <p className="eyebrow">Related</p>
              <h2 className="mt-3 font-serif text-3xl font-medium leading-tight tracking-tight text-ink-900">
                Related categories
              </h2>
              <div className="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
                {related.map((r) => {
                  const RIcon = r.icon;
                  return (
                    <Link
                      key={r.slug}
                      href={`/laws/${r.slug}`}
                      className="group card-heritage p-5"
                    >
                      <div className="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-saffron-50 text-saffron-700">
                        <RIcon className="h-4 w-4" />
                      </div>
                      <h3 className="mt-4 font-serif text-[17px] font-medium leading-tight tracking-tight text-ink-900">
                        {r.title}
                      </h3>
                      <p className="mt-1.5 text-[12.5px] text-ink-500 line-clamp-2">
                        {r.tagline}
                      </p>
                    </Link>
                  );
                })}
              </div>
            </section>
          </div>
        </div>
      </section>
    </>
  );
}
